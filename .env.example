# ==============================================================================
# SERVER ENVIRONMENT TEMPLATE
# ==============================================================================

PORT=5050
NODE_ENV=development

# JWT Secret
JWT_SECRET=smart-utility-sih-secret-key-2026-secure-jwt
JWT_EXPIRES_IN=7d

# Database Path (SQLite)
DB_PATH=../data/smart_utility.db

# Database Configuration (MongoDB)
# Local MongoDB: mongodb://127.0.0.1:27017/smart_utility
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_utility?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smart_utility
MONGODB_ENABLED=true
MONGODB_AUTO_SEED=true

# CORS Origin
CORS_ORIGIN=http://localhost:5173
